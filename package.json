{
  "name": "dsh-web-search-insights",
  "version": "0.1.0",
  "description": "记录每次 web_search 的关键词、返回来源与失败错误码，按轮次与会话统计引用、返回与被抓取的页面，并在回答末尾与右侧栏提供引用入口、可筛选搜索面板，以及不写入日志的快速搜索视图。",
  "author": "ypingcn",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ypingcn/dsh-web-search-insights.git"
  },
  "homepage": "https://github.com/ypingcn/dsh-web-search-insights#readme",
  "bugs": {
    "url": "https://github.com/ypingcn/dsh-web-search-insights/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "docs/screenshots",
    "locale/*.json"
  ],
  "scripts": {
    "test": "node test/url-utils.test.mjs && node test/projection.test.mjs && node test/client.test.mjs && node test/quick-search.test.mjs && node test/unit.mjs",
    "check": "node --check lib/client.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "web-search",
    "insights",
    "statistics",
    "citations"
  ],
  "license": "MIT"
}
