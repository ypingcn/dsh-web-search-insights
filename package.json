{
  "name": "dsh-web-search-insights",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: log web_search queries and returned URLs, project per-turn citation statistics, and render the answer-tail entry plus the right-sidebar search panel",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json"
  ],
  "scripts": {
    "test": "node test/url-utils.test.mjs && node test/projection.test.mjs && node test/client.test.mjs && node test/quick-search.test.mjs && node test/unit.mjs",
    "check": "node --check lib/client.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "web-search",
    "insights",
    "statistics",
    "citations"
  ],
  "license": "MIT"
}
